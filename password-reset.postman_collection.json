{
  "info": {
    "_postman_id": "5b466475-4420-4aba-af2b-22453d2c76cd",
    "name": "password-reset",
    "description": "Full password-reset flow: register, forgot-password, verify token, reset password.\n\nSet the `base_url` variable in the bundled environment before running.\n\nThe **Forgot Password** request automatically extracts the reset token from the `previewUrl` in the response and stores it in `{{resetToken}}` — used by the two reset-password requests that follow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "previewUrl",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test1234!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Create a new user account. Password must be 8+ chars with upper, lower, number, and special character.\n\nReturns 409 if the email is already registered."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "",
              "if (pm.response.code === 201) {",
              "    pm.test('Account created', () => pm.expect(data.success).to.be.true);",
              "    pm.test('Response contains user id', () => pm.expect(data.data).to.have.property('id'));",
              "} else if (pm.response.code === 409) {",
              "    pm.test('Email already registered (expected if re-running)', () => pm.expect(data.success).to.be.false);",
              "} else {",
              "    pm.test('Unexpected status', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Forgot Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "forgot-password"]
        },
        "description": "Request a password reset link for the given email.\n\n- Returns **404** if no account exists with that email.\n- Returns **200** with `previewUrl` when `EMAIL_TRANSPORT=ethereal`. The test script extracts the reset token from `previewUrl` and saves it to `{{resetToken}}`.\n- Rate limited to 5 requests per 15 minutes."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('success is true', () => pm.expect(data.success).to.be.true);",
              "pm.test('previewUrl present', () => pm.expect(data).to.have.property('previewUrl'));",
              "",
              "if (data.previewUrl) {",
              "    pm.collectionVariables.set('previewUrl', data.previewUrl);",
              "",
              "    // Extract token from URL: .../reset-password/<hex-token>",
              "    const match = data.previewUrl.match(/reset-password\\/([a-f0-9]{64})/);",
              "    if (match) {",
              "        pm.collectionVariables.set('resetToken', match[1]);",
              "        console.log('Reset token captured:', match[1]);",
              "    } else {",
              "        console.warn('Could not extract token from previewUrl:', data.previewUrl);",
              "    }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Forgot Password – Unknown Email (404)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nobody@example.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "forgot-password"]
        },
        "description": "Verifies that the API returns 404 when the email is not registered — matches the spec requirement."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "",
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('success is false', () => pm.expect(data.success).to.be.false);",
              "pm.test('Descriptive error message', () => pm.expect(data.message).to.include('No account found'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify Reset Token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/auth/reset-password/{{resetToken}}",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "reset-password", "{{resetToken}}"]
        },
        "description": "Validates the token before showing the reset form.\n\n- **200** — token is valid and not expired\n- **400** — token does not exist / already used\n- **410** — token has expired\n\nUses `{{resetToken}}` set automatically by the Forgot Password test script."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('success is true', () => pm.expect(data.success).to.be.true);",
              "pm.test('Reset link is valid', () => pm.expect(data.message).to.include('valid'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"NewPass123!\",\n  \"confirmPassword\": \"NewPass123!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/reset-password/{{resetToken}}",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "reset-password", "{{resetToken}}"]
        },
        "description": "Submits the new password. Both `password` and `confirmPassword` are required and must match.\n\nPassword rules: 8+ chars, upper, lower, number, special character.\n\nOn success the token is invalidated — re-using it returns 400."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('success is true', () => pm.expect(data.success).to.be.true);",
              "pm.test('Success message', () => pm.expect(data.message).to.include('reset successfully'));",
              "",
              "// Token is now consumed — clear the variable",
              "pm.collectionVariables.set('resetToken', '');"
            ]
          }
        }
      ]
    },
    {
      "name": "Reset Password – Reuse Token (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"AnotherPass1!\",\n  \"confirmPassword\": \"AnotherPass1!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/reset-password/{{resetToken}}",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "reset-password", "{{resetToken}}"]
        },
        "description": "Run this immediately after Reset Password to confirm the token is invalidated after use."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "",
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('success is false', () => pm.expect(data.success).to.be.false);"
            ]
          }
        }
      ]
    }
  ]
}
