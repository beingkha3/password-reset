{
  "info": {
    "name": "password-reset",
    "description": "Run requests in order: 1 → 2 → 3 → 4 → 5.\n\nStep 2 captures {{resetToken}} automatically. Steps 3-5 depend on it.\n\nEnvironment: password-reset (production) must be selected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b489ba92-ed55-4690-a608-fed549f40de8"
  },
  "variable": [
    { "key": "resetToken", "value": "" },
    { "key": "previewUrl", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test1234!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Create a new account. Returns 409 if the email is already registered — safe to re-run."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (pm.response.code === 201) {",
              "  pm.test('Account created', () => pm.expect(data.success).to.be.true);",
              "} else if (pm.response.code === 409) {",
              "  pm.test('Already registered — ok to re-run', () => pm.expect(data.success).to.be.false);",
              "} else {",
              "  pm.test('Unexpected status ' + pm.response.code, () => { throw new Error(JSON.stringify(data)); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Forgot Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "forgot-password"]
        },
        "description": "Sends a reset link. The test script extracts the token from previewUrl and stores it in {{resetToken}}.\n\nRun this before steps 3-5."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('success true', () => pm.expect(data.success).to.be.true);",
              "pm.test('previewUrl present', () => pm.expect(data).to.have.property('previewUrl'));",
              "",
              "if (data.previewUrl) {",
              "  pm.collectionVariables.set('previewUrl', data.previewUrl);",
              "  const match = data.previewUrl.match(/reset-password\\/([a-f0-9]{64})/);",
              "  if (match) {",
              "    pm.collectionVariables.set('resetToken', match[1]);",
              "    console.log('resetToken set:', match[1]);",
              "  } else {",
              "    console.warn('Could not extract token. previewUrl was:', data.previewUrl);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2b. Forgot Password - Unknown Email (404)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nobody@example.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "forgot-password"]
        },
        "description": "Confirms 404 is returned for an unregistered email."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('success false', () => pm.expect(data.success).to.be.false);",
              "pm.test('Error message', () => pm.expect(data.message).to.include('No account found'));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Verify Reset Token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/auth/reset-password/{{resetToken}}",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "reset-password", "{{resetToken}}"]
        },
        "description": "Checks the token is valid.\n200 = valid | 400 = invalid/used | 410 = expired\n\nREQUIRES: run step 2 first so {{resetToken}} is populated."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.collectionVariables.get('resetToken');",
              "if (!token) {",
              "  throw new Error('{{resetToken}} is empty — run step 2 (Forgot Password) first.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('success true', () => pm.expect(data.success).to.be.true);",
              "pm.test('Token valid', () => pm.expect(data.message).to.include('valid'));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Reset Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"NewPass123!\",\n  \"confirmPassword\": \"NewPass123!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/reset-password/{{resetToken}}",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "reset-password", "{{resetToken}}"]
        },
        "description": "Submits the new password. Token is invalidated after this call.\n\nREQUIRES: run step 2 first."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.collectionVariables.get('resetToken');",
              "if (!token) {",
              "  throw new Error('{{resetToken}} is empty — run step 2 (Forgot Password) first.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('success true', () => pm.expect(data.success).to.be.true);",
              "pm.test('Reset successful', () => pm.expect(data.message).to.include('reset successfully'));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Reset Password - Reuse Token (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"AnotherPass1!\",\n  \"confirmPassword\": \"AnotherPass1!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/reset-password/{{resetToken}}",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "reset-password", "{{resetToken}}"]
        },
        "description": "Run immediately after step 4. Confirms the token is single-use — returns 400."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.collectionVariables.get('resetToken');",
              "if (!token) {",
              "  throw new Error('{{resetToken}} is empty — run step 2 (Forgot Password) first, then step 4.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('success false', () => pm.expect(data.success).to.be.false);",
              "pm.collectionVariables.set('resetToken', '');"
            ]
          }
        }
      ]
    }
  ]
}
