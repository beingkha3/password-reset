MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRY_MINUTES=15

# Auth (JWT). Generate a long random string for JWT_SECRET in production.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Email delivery via Brevo HTTP API (https://app.brevo.com → SMTP & API → API Keys)
BREVO_API_KEY=your_brevo_api_key
SMTP_FROM=Password Reset <noreply@yourdomain.com>

# Test-only endpoints (Postman Runner, automated tests). NEVER set this to true in production.
# When enabled, forgot-password also stashes the raw token in process memory and
# GET /api/auth/test/latest-reset-token?email=... returns it so automated tests don't
# need to read the reset email manually.
ENABLE_TEST_ENDPOINTS=false
