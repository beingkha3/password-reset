MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRY_MINUTES=15

# EMAIL_TRANSPORT options:
#   ethereal  - Nodemailer test service; returns a preview URL in the API response (default for dev/staging)
#   console   - Prints the reset URL to server logs only
#   smtp      - Real SMTP delivery; requires the SMTP_* vars below
EMAIL_TRANSPORT=ethereal
SMTP_FROM=Password Reset <no-reply@example.com>

# Required only when EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<username>
# SMTP_PASS=<password>

# Required only when EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<username>
# SMTP_PASS=<password>
